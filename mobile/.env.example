# ============================================================
# Environment variables for the mobile app (Expo)
# Copy this file to `.env` and fill in your own values.
#   PowerShell : Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Note: only variables prefixed with EXPO_PUBLIC_ are exposed
# to the app. Never put secret keys here.
# Restart the dev server (`npx expo start -c`) after changing.
# ============================================================

# Clerk publishable key for authentication.
# Get it from https://dashboard.clerk.com -> your app -> API Keys.
# It must start with `pk_test_` (development) or `pk_live_` (production).
# Do NOT use the secret key (sk_...) here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Base URL of your wallet backend API (must include the `/api` path).
# - Hosted backend (example):
EXPO_PUBLIC_API_URL=https://your-api-domain.com/api
# - Local backend on a physical device (use your computer's LAN IP,
#   `localhost` points to the phone itself):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5001/api
# - Android emulator (10.0.2.2 = host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api
