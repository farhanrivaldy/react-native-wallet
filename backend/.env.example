# Konfigurasi Server
PORT=5001

# Database PostgreSQL (Neon)
# Dapatkan connection string dari: https://console.neon.tech/
DATABASE_URL=postgresql://username:password@host:port/nama_database?sslmode=require

# Redis (Upstash) untuk caching & rate limiting
# Dapatkan REST URL dan Token dari: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://nama-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token